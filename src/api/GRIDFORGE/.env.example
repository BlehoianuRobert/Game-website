APP_NAME=GRIDFORGE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────────────────────────
# Get these from your Neon dashboard → Project → Connection Details
# Example connection string: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=ep-example-name-123456.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=gridforge
DB_USERNAME=gridforge_user
DB_PASSWORD=your_neon_password
DB_SSLMODE=require
# Endpoint ID = first segment of DB_HOST before -pooler (e.g. ep-example-name-123456)
NEON_ENDPOINT=ep-example-name-123456

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: php artisan jwt:secret
JWT_SECRET=your_generated_jwt_secret_here
JWT_TTL=60

# ─── CACHE ───────────────────────────────────────────────────────────────────
CACHE_STORE=file

# ─── SESSION ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=nullSESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PARTITIONED_COOKIE=true
# ─── QUEUE ───────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
